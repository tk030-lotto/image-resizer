{
  "name": "image-resizer",
  "version": "0.1.0",
  "private": true,
  "description": "長辺指定で画像を一括リサイズする高速Webツール(完全クライアントサイド・オフライン動作)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'index.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.0"
  }
}
